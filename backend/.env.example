# ==============================================================================
# ProspectIQ Backend Environment Configuration
# ==============================================================================

# Groq LLM API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model Selection (Free tier Groq models)
DEFAULT_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# Runtime & Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Execution Limits & Resilience
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0

# Database Configuration (Level 4+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prospectiq
