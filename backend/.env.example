# ==============================================================================
# ProspectIQ Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get a free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Google Gemini Free Tier: 15 RPM, 1M TPM, 1500 RPD)
DEFAULT_MODEL=gemini-3.1-flash-lite
FAST_MODEL=gemini-3.1-flash-lite

# Runtime & Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Execution Limits & Resilience
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0

# Database Configuration (Level 4+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prospectiq
